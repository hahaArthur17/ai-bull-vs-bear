{
  "name": "ai-bull-vs-bear-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test:stream": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test src/*.test.ts",
    "test": "npm run test:stream && npm run test:integration",
    "format": "prettier --write App.tsx src app.config.js app.json tsconfig.json package.json vitest.config.mts",
    "format:check": "prettier --check App.tsx src app.config.js app.json tsconfig.json package.json vitest.config.mts",
    "test:ui": "vitest run",
    "test:integration": "python3 ../../scripts/run_ui_integration.py"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.112.3",
    "dotenv": "^17.4.2",
    "expo": "^54.0.37",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.14",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.0",
    "unicode-segmenter": "0.17.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "~19.1.10",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "~5.9.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "metro": "0.83.8",
    "postcss": "8.5.30",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
