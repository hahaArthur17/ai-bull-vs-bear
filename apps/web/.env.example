# Public browser build configuration. Never place secrets in VITE_* variables.
# Parsed and validated at startup; npm run build explicitly selects demo mode.
VITE_DATA_MODE=demo
VITE_API_BASE_URL=/api

# Feedback delivery is independent of the research-data mode.
# demo: browser-only simulation; api: real receiver; disabled: submission unavailable.
# The feedback backend does not exist yet, so the initial build uses demo.
VITE_FEEDBACK_MODE=demo
# Required only for api mode; use the verified receiver base URL, without /feedback.
VITE_FEEDBACK_API_BASE_URL=
