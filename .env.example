# Backend
ENVIRONMENT=development
AUTH_MODE=demo
PERSISTENCE_MODE=demo
ANALYSIS_PROVIDER=demo
# Default-off V2 Debate API. It stays synchronous unless Queue is enabled.
DEBATE_WORKFLOW_V2=false
# Separately enables durable Queue admission. Keep false until the Queue
# migration and Worker have been verified against the target Supabase project.
DEBATE_QUEUE_ENABLED=false
DEBATE_WORKER_VISIBILITY_TIMEOUT_SECONDS=900
DEBATE_WORKER_CONCURRENCY=1
DEBATE_WORKER_POLL_SECONDS=1
# Optional Redis optimization/coordination layer. Use rediss:// for hosted TLS.
REDIS_ENABLED=false
REDIS_URL=
REDIS_CONNECT_TIMEOUT_SECONDS=0.75
REDIS_SOCKET_TIMEOUT_SECONDS=0.75
DEBATE_RATE_LIMIT_PER_WINDOW=3
DEBATE_RATE_LIMIT_WINDOW_SECONDS=3600
DEBATE_ACTIVE_TTL_SECONDS=1200
DEBATE_IDEMPOTENCY_LOCK_TTL_SECONDS=120
# Explanation is separately bounded per authenticated user and never changes
# canonical Debate state. Its admission key stores only a user hash.
EXPLANATION_RATE_LIMIT_PER_WINDOW=12
EXPLANATION_RATE_LIMIT_WINDOW_SECONDS=3600
# Independent async Turn provider. "groq" is live and consumes API quota.
DEBATE_STREAMING_PROVIDER=deterministic
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# Expo client. These values are public and must never contain server secrets.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# Set demo to bypass Supabase Auth only when the backend also runs in demo mode.
EXPO_PUBLIC_AUTH_MODE=auto
# Mounts the Queue/SSE Debate client. Keep false unless backend V2 is enabled.
EXPO_PUBLIC_DEBATE_V2_ENABLED=false

# Optional Supabase configuration. Keep credentials in .env, never in Git.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side ingestion only. Never expose this value to Expo or commit it.
SUPABASE_SECRET_KEY=
# Optional non-production users for scripts/verify_supabase_rls.py.
SUPABASE_RLS_USER_A_EMAIL=
SUPABASE_RLS_USER_A_PASSWORD=
SUPABASE_RLS_USER_B_EMAIL=
SUPABASE_RLS_USER_B_PASSWORD=

# Required only for SEC ingestion. Use a project name and monitored contact email.
SEC_USER_AGENT=AI Bull vs Bear contact@example.com

# Optional AAPL daily-price cache. Alpha Vantage's free tier allows 25 requests/day.
ALPHA_VANTAGE_API_KEY=
PRICE_TICKERS=AAPL
PRICE_MAX_CALLS_PER_RUN=1
PRICE_STALE_AFTER_DAYS=5
LIVE_EVIDENCE_TICKERS=AAPL

# Optional macro-economic data. Both providers issue free keys; keep them
# server-side and run scheduled cache refreshes rather than browser requests.
FRED_API_KEY=
EIA_API_KEY=
MACRO_HISTORY_POINTS=400
WEEKLY_PRICE_HISTORY_POINTS=60

# Optional alternative data providers. Apify also requires a selected Actor/task
# before it can act as a concrete market-data source.
APIFY_USER_ID=
APIFY_API_TOKEN=
# Used for the latest quote and, when the account permits daily candles, as a
# fallback daily-price provider. Keep it server-side only.
FINNHUB_API_KEY=

# Optional model providers. Keep these values local and never commit .env.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
DEBATE_GROQ_MODEL=openai/gpt-oss-20b
DEBATE_PROVIDER_TIMEOUT_SECONDS=45
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
